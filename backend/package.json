    "mark:project-tasks-done": "node scripts/mark-project-tasks-done.mjs",
    "test:security:baseline": "node scripts/validate-security-baseline.mjs",
    "test:security:smoke": "node scripts/security-smoke.mjs",
    "test:e2e:platform": "node scripts/platform-e2e.mjs",
    "test:alignment:smoke": "node scripts/alignment-contract-smoke.mjs",
    "test:alignment-scoring:smoke": "node scripts/alignment-scoring-smoke.mjs",
    "test:alignment-clarification:smoke": "node scripts/alignment-clarification-smoke.mjs",
    "test:visual-requirement:smoke": "node scripts/visual-requirement-smoke.mjs",
