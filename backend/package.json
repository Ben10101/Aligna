    "test:agent-run-recovery:smoke": "node scripts/agent-run-recovery-smoke.mjs",
    "test:generated-app-run-recovery:smoke": "node scripts/generated-app-run-recovery-smoke.mjs",
    "test:project-manager-recovery:smoke": "node scripts/project-manager-recovery-smoke.mjs",
    "test:architect-recovery:smoke": "node scripts/architect-recovery-smoke.mjs",
    "test:requirements-recovery:smoke": "node scripts/requirements-recovery-smoke.mjs",
    "test:qa-recovery:smoke": "node scripts/qa-recovery-smoke.mjs",
    "test:runtime-observability:smoke": "node scripts/runtime-observability-smoke.mjs",
    "test:pipeline-coherence:smoke": "node scripts/pipeline-coherence-smoke.mjs",
    "test:project-status:smoke": "node scripts/project-status-flow-smoke.mjs",
    "report:implementation-autonomy": "node scripts/implementation-autonomy-overview.mjs",
