    "test:backlog-reconciliation:smoke": "node scripts/backlog-final-reconciliation-smoke.mjs",
    "test:requirement-engine:smoke": "node scripts/requirement-engine-smoke.mjs",
    "test:requirement-challenger:smoke": "node scripts/requirement-challenger-smoke.mjs",
    "test:requirement-judge:smoke": "node scripts/requirement-judge-smoke.mjs",
