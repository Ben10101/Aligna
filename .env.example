NODE_ENV=development
PORT=3001
VITE_API_URL=http://localhost:3001/api
FRONTEND_ORIGIN=http://localhost:5173

# Required secrets
AUTH_ACCESS_SECRET=change-me-to-a-long-random-secret
# Sessão renovável em dias (entre 1 e 90; padrão: 30).
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AI_SETTINGS_SECRET=change-me-to-a-different-long-random-secret
AI_PROMPT_VERSION=v3-claude-cookbook-ui

# Database
DATABASE_URL=mysql://root@localhost:3306/ai_factory

# Optional AI providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen3.5-122b-a10b
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_MODEL=gemma3:4b
OLLAMA_HOST=http://127.0.0.1:11434

# Optional Model Router. Leave unset to build the registry from the provider models above.
# MODEL_ROUTER_REGISTRY_JSON={"models":[{"id":"openai:gpt-4.1-mini","provider":"openai","model":"gpt-4.1-mini","capabilities":["text","reasoning","structured_output","code"],"context_limit":128000,"enabled":true,"priority":10,"temperature":0.1,"max_tokens":1800,"estimated_cost_usd_per_1k_tokens":0.0000035}]}
# MODEL_ROUTER_DISABLED_MODELS=ollama:gemma3:4b
# A 429 is retried within this bounded transport budget. Retry-After is used when available.
# MODEL_ROUTER_TRANSIENT_RETRIES=1
# MODEL_ROUTER_MAX_RETRY_DELAY_SECONDS=15
# Additional OpenRouter models may be tried when the primary returns no usable text.
# OPENROUTER_MODEL_FALLBACKS=model-a,model-b

# Time limits for AI requirement generation. They prevent a slow fallback provider
# from holding a task in progress after another provider already failed.
# Per-provider timeout; bounded to 45 seconds by the requirements agent.
# REQUIREMENTS_LLM_REQUEST_TIMEOUT_SECONDS=45
# REQUIREMENTS_REVIEW_TIMEOUT_SECONDS=45

# Project Manager generates the entire backlog in one AI response and, only when
# the returned structure is invalid, makes one focused repair attempt.
# Each provider attempt is bounded; no provider-level transient retry is used by this agent.
# PROJECT_MANAGER_LLM_REQUEST_TIMEOUT_SECONDS=45
# PROJECT_MANAGER_BACKLOG_MAX_ATTEMPTS=2
# PROJECT_MANAGER_BACKLOG_NUM_PREDICT=3400
# Optional strict mode. When true, an unavailable AI evidence reviewer blocks the
# refinement; the default false keeps the generated refinement available and logs
# the unavailable review for follow-up.
# REQUIREMENTS_EVIDENCE_REVIEW_REQUIRED=false

# Optional Requirement Engine semantic stages. The deterministic requirement model always remains available.
# ALIGNMENT_REQUIREMENT_ENGINE_LLM_ENABLED=false
